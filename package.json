{
  "name": "mcpmanager",
  "private": true,
  "workspaces": [
    "apps/gateway",
    "apps/chrome-extension/server"
  ],
  "scripts": {
    "setup": "bun run --cwd apps/gateway manager install",
    "centralize": "bun run --cwd apps/gateway manager centralize",
    "decentralize": "bun run --cwd apps/gateway manager decentralize -- --apply",
    "test:playwright-pool": "bun run --cwd apps/gateway test:playwright-pool",
    "test:llm-shell": "bun run --cwd apps/gateway test:llm-shell",
    "test:interactions-claude": "bun run --cwd apps/gateway test:interactions-claude",
    "dev:gateway": "bun run --cwd apps/gateway dev",
    "build:gateway:exe": "bun run --cwd apps/gateway build:exe",
    "build:manager:exe": "bun run --cwd apps/gateway build:manager:exe"
  }
}
