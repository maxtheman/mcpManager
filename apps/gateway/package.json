{
  "name": "@mcpmanager/gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/cli.ts",
    "manager": "bun src/manager-cli.ts",
    "doctor": "bun src/manager-cli.ts doctor",
    "install:clients": "bun src/manager-cli.ts install",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "build:exe": "bun build --compile src/cli.ts --outfile dist/mcpmanager-gateway",
    "build:manager:exe": "bun build --compile src/manager-cli.ts --outfile dist/mcpmanager",
    "lint": "bunx eslint .",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@daytonaio/sdk": "^0.9.2",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "bun-types": "^1.3.3",
    "@types/node": "^24.3.0",
    "typescript": "~5.8.3"
  }
}
